<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Teknomen (Pvt) Ltd — Your Partner in Progress</title>
<meta name="description" content="TEKNOMEN delivers practical engineering solutions for Industrial Automation, VFDs, Customized Control Systems, Spindle Monitoring, Industrial Power Backup, PCB Design & Fabrication." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
/* ============================================================
   THEME TOKENS — Classy editorial palette
============================================================ */
:root{
  /* Light — warm ivory, deep navy, antique gold */
  --bg:          #faf7f0;
  --bg-alt:      #f2ede2;
  --surface:     #ffffff;
  --surface-2:   #f7f3ea;

  --text:        #0a1a2f;
  --text-soft:   #3d4a5c;
  --text-muted:  #7a8394;

  --border:      #e6ddc9;
  --border-2:    #d9cfb8;

  --navy:        #0d3b66;
  --navy-2:      #14497a;
  --gold:        #b8893a;
  --gold-2:      #d4a55a;
  --copper:      #b06a3b;

  --accent-grad: linear-gradient(90deg, #0d3b66 0%, #b8893a 100%);
  --soft-grad:   linear-gradient(135deg, rgba(13,59,102,.06) 0%, rgba(184,137,58,.06) 100%);

  --shadow-sm:   0 1px 2px rgba(10,26,47,.04), 0 2px 8px rgba(10,26,47,.04);
  --shadow-md:   0 8px 30px rgba(10,26,47,.07);
  --shadow-lg:   0 30px 70px rgba(10,26,47,.14);
  --shadow-gold: 0 12px 40px rgba(184,137,58,.28);

  --radius:      6px;
  --radius-lg:   14px;
  --container:   1240px;
  --ease:        cubic-bezier(.22,.61,.36,1);
  --ease-out:    cubic-bezier(.16,1,.3,1);
}

[data-theme="dark"]{
  /* Dark — midnight, warm ivory text, soft gold */
  --bg:          #080f1a;
  --bg-alt:      #0d1622;
  --surface:     #111d2e;
  --surface-2:   #16243a;

  --text:        #ece6d6;
  --text-soft:   #b6c1d0;
  --text-muted:  #7c8a9e;

  --border:      #1c2a3f;
  --border-2:    #26374f;

  --navy:        #5aa3dd;
  --navy-2:      #7eb8e8;
  --gold:        #dfb166;
  --gold-2:      #efc98a;
  --copper:      #d68b5a;

  --accent-grad: linear-gradient(90deg, #5aa3dd 0%, #dfb166 100%);
  --soft-grad:   linear-gradient(135deg, rgba(90,163,221,.10) 0%, rgba(223,177,102,.08) 100%);

  --shadow-sm:   0 1px 2px rgba(0,0,0,.4), 0 2px 8px rgba(0,0,0,.35);
  --shadow-md:   0 10px 34px rgba(0,0,0,.5);
  --shadow-lg:   0 30px 70px rgba(0,0,0,.65);
  --shadow-gold: 0 12px 44px rgba(223,177,102,.22);
}

/* ============================================================
   BASE
============================================================ */
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.7;
  font-weight:400;
  -webkit-font-smoothing:antialiased;
  transition: background .5s var(--ease), color .5s var(--ease);
  overflow-x:hidden;
}

/* Grain texture */
body::before{
  content:'';
  position:fixed;inset:0;z-index:1;pointer-events:none;
  opacity:.035;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  mix-blend-mode:multiply;
}
[data-theme="dark"] body::before{mix-blend-mode:screen;opacity:.05}

h1,h2,h3,h4,h5{
  font-family:'Fraunces',serif;
  font-weight:500;
  line-height:1.12;
  letter-spacing:-.02em;
  margin:0;
  color:var(--text);
  font-variation-settings:"opsz" 144;
}
h1{font-weight:400}
h2{font-weight:500}
p{margin:0 0 1em}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block;height:auto}
button{font-family:inherit;cursor:pointer;border:0;background:none;color:inherit}
::selection{background:var(--gold);color:#fff}

.container{max-width:var(--container);margin:0 auto;padding:0 28px;position:relative;z-index:2}
.section{padding:120px 0;position:relative}
.section-alt{background:var(--bg-alt)}

/* Eyebrow + numbered labels */
.eyebrow{
  display:inline-flex;align-items:center;gap:12px;
  font-family:'Inter',sans-serif;
  text-transform:uppercase;
  font-size:.72rem;
  letter-spacing:.28em;
  color:var(--gold);
  font-weight:600;
  margin-bottom:22px;
}
.eyebrow::before{
  content:'';width:32px;height:1px;background:var(--gold);display:block;
}
.eyebrow.no-line::before{display:none}

.section-title{
  font-size:clamp(2.2rem,4.6vw,3.8rem);
  margin-bottom:22px;
  letter-spacing:-.03em;
}
.section-title em{
  font-style:italic;color:var(--gold);font-weight:400;
}
.section-sub{
  color:var(--text-soft);
  max-width:620px;
  font-size:1.02rem;
  line-height:1.75;
}

/* Section number badge */
.sec-num{
  font-family:'Fraunces',serif;
  font-size:.9rem;
  color:var(--text-muted);
  letter-spacing:.3em;
  font-variation-settings:"opsz" 144;
  font-weight:500;
}

/* Buttons */
.btn{
  display:inline-flex;align-items:center;gap:12px;
  padding:15px 30px;
  border-radius:2px;
  font-family:'Inter',sans-serif;
  font-weight:500;letter-spacing:.02em;
  font-size:.9rem;
  transition: all .4s var(--ease);
  position:relative;overflow:hidden;
  border:1px solid transparent;
}
.btn-primary{
  background:var(--navy);
  color:#fff;
}
[data-theme="dark"] .btn-primary{background:var(--navy);color:#080f1a}
.btn-primary::before{
  content:'';position:absolute;inset:0;
  background:var(--gold);
  transform:translateY(101%);
  transition:transform .5s var(--ease-out);
}
[data-theme="dark"] .btn-primary::before{background:var(--gold)}
.btn-primary:hover::before{transform:translateY(0)}
.btn-primary > *{position:relative;z-index:1}
.btn-primary:hover{color:#fff}
[data-theme="dark"] .btn-primary:hover{color:#080f1a}

.btn-ghost{
  border-color:var(--border-2);
  color:var(--text);
}
.btn-ghost:hover{
  border-color:var(--gold);
  color:var(--gold);
  padding-left:38px;
}
.btn i{transition:transform .4s var(--ease)}
.btn:hover i{transform:translateX(5px)}

/* Hairline link (underline sweep) */
.hairline{
  display:inline-flex;align-items:center;gap:8px;
  position:relative;font-weight:500;font-size:.9rem;
  color:var(--text);
  padding-bottom:2px;
}
.hairline::after{
  content:'';position:absolute;left:0;bottom:0;right:0;height:1px;
  background:var(--gold);
  transform:scaleX(0);transform-origin:right;
  transition:transform .5s var(--ease-out);
}
.hairline:hover::after{transform:scaleX(1);transform-origin:left}

/* ============================================================
   SCROLL PROGRESS LINE
============================================================ */
.scroll-progress{
  position:fixed;top:0;left:0;right:0;height:2px;
  z-index:2000;background:transparent;
  pointer-events:none;
}
.scroll-progress__bar{
  height:100%;width:0%;
  background:var(--accent-grad);
  box-shadow:0 0 12px rgba(184,137,58,.5);
  transition:width .08s linear;
}

/* ============================================================
   HEADER
============================================================ */
.header{
  position:fixed;top:2px;left:0;right:0;z-index:1000;
  background:color-mix(in srgb, var(--bg) 78%, transparent);
  backdrop-filter:saturate(180%) blur(20px);
  -webkit-backdrop-filter:saturate(180%) blur(20px);
  border-bottom:1px solid transparent;
  transition: all .4s var(--ease);
}
.header.scrolled{
  border-bottom-color:var(--border);
}
.header-inner{
  display:flex;align-items:center;justify-content:space-between;
  height:86px;
  transition:height .4s var(--ease);
}
.header.scrolled .header-inner{height:74px}

/* Logo (uses real image) */
.logo{
  display:flex;align-items:center;gap:14px;
  transition:opacity .3s var(--ease);
}
.logo img{
  height:38px;width:auto;
  transition:height .4s var(--ease), filter .4s var(--ease);
  filter: brightness(0) saturate(100%) invert(15%) sepia(38%) saturate(2476%) hue-rotate(193deg) brightness(95%) contrast(95%);
}
[data-theme="dark"] .logo img{
  filter: brightness(0) saturate(100%) invert(92%) sepia(8%) saturate(600%) hue-rotate(346deg) brightness(98%) contrast(92%);
}
.header.scrolled .logo img{height:32px}

/* Nav */
.nav{display:flex;align-items:center;gap:2px}
.nav a{
  padding:10px 16px;
  font-size:.9rem;font-weight:500;
  color:var(--text-soft);
  position:relative;
  transition: color .3s var(--ease);
}
.nav a::after{
  content:'';position:absolute;left:16px;right:16px;bottom:4px;height:1px;
  background:var(--gold);
  transform:scaleX(0);transform-origin:right;
  transition:transform .45s var(--ease-out);
}
.nav a:hover, .nav a.active{color:var(--text)}
.nav a:hover::after, .nav a.active::after{
  transform:scaleX(1);transform-origin:left;
}

.header-actions{display:flex;align-items:center;gap:14px}

/* Theme toggle */
.theme-toggle{
  width:40px;height:40px;border-radius:50%;
  display:grid;place-items:center;
  border:1px solid var(--border-2);
  color:var(--text-soft);
  transition: all .4s var(--ease);
  position:relative;overflow:hidden;
}
.theme-toggle::before{
  content:'';position:absolute;inset:0;border-radius:50%;
  background:var(--gold);
  transform:scale(0);
  transition:transform .4s var(--ease-out);
}
.theme-toggle:hover::before{transform:scale(1)}
.theme-toggle:hover{color:#fff;border-color:var(--gold)}
.theme-toggle i{position:absolute;z-index:1;font-size:.9rem;transition:all .55s var(--ease-out)}
.theme-toggle .fa-sun{opacity:0;transform:scale(.4) rotate(90deg)}
.theme-toggle .fa-moon{opacity:1;transform:scale(1) rotate(0)}
[data-theme="dark"] .theme-toggle .fa-sun{opacity:1;transform:scale(1) rotate(0)}
[data-theme="dark"] .theme-toggle .fa-moon{opacity:0;transform:scale(.4) rotate(-90deg)}

/* CTA in header */
.header-cta{
  padding:11px 22px;
  background:var(--navy);color:#fff;
  font-size:.82rem;font-weight:500;
  letter-spacing:.04em;
  border-radius:2px;
  transition: all .35s var(--ease);
  position:relative;overflow:hidden;
}
[data-theme="dark"] .header-cta{color:#080f1a}
.header-cta::before{
  content:'';position:absolute;inset:0;
  background:var(--gold);
  transform:translateY(101%);
  transition:transform .4s var(--ease-out);
}
.header-cta:hover::before{transform:translateY(0)}
.header-cta span{position:relative;z-index:1}
.header-cta:hover{color:#fff}
[data-theme="dark"] .header-cta:hover{color:#080f1a}

.menu-toggle{display:none;width:42px;height:42px;color:var(--text);font-size:1.05rem}

@media(max-width:1000px){
  .nav{
    position:fixed;top:88px;left:0;right:0;
    background:var(--bg);
    flex-direction:column;align-items:stretch;
    padding:16px;gap:2px;
    border-top:1px solid var(--border);
    border-bottom:1px solid var(--border);
    transform:translateY(-120%);
    transition:transform .45s var(--ease);
    max-height:calc(100vh - 88px);overflow-y:auto;
  }
  .nav.open{transform:translateY(0)}
  .nav a{padding:16px 18px}
  .menu-toggle{display:grid;place-items:center}
  .header-cta{display:none}
}

/* ============================================================
   HERO — editorial
============================================================ */
.hero{
  position:relative;
  min-height:100vh;
  padding:180px 0 100px;
  display:flex;align-items:center;
  overflow:hidden;
  isolation:isolate;
  background:var(--bg);
}
.hero::before{
  content:'';position:absolute;inset:0;z-index:-1;
  background:
    radial-gradient(circle at 15% 20%, color-mix(in srgb, var(--gold) 8%, transparent), transparent 45%),
    radial-gradient(circle at 85% 75%, color-mix(in srgb, var(--navy) 6%, transparent), transparent 50%);
}

/* Decorative vertical rule + section number */
.hero-deco{
  position:absolute;top:180px;bottom:80px;left:28px;width:1px;
  background:linear-gradient(to bottom, transparent, var(--border-2), transparent);
  z-index:1;
}
.hero-deco span{
  position:absolute;top:0;left:50%;transform:translateX(-50%);
  background:var(--bg);padding:6px 0;
  font-family:'Fraunces',serif;
  font-size:.75rem;letter-spacing:.3em;
  color:var(--text-muted);
}

.hero-grid{
  display:grid;grid-template-columns:1.15fr .95fr;gap:80px;align-items:center;
  position:relative;z-index:2;
}

.hero-content{max-width:640px}
.hero-content .eyebrow{margin-bottom:28px}
.hero-content h1{
  font-size:clamp(2.6rem,5.6vw,4.6rem);
  line-height:1.02;
  margin-bottom:30px;
  letter-spacing:-.035em;
  font-weight:400;
}
.hero-content h1 em{
  font-style:italic;
  color:var(--gold);
  font-weight:300;
}
.hero-content p{
  color:var(--text-soft);
  font-size:1.08rem;
  line-height:1.75;
  max-width:540px;
  margin-bottom:40px;
}
.hero-cta{display:flex;gap:16px;flex-wrap:wrap;align-items:center}

/* Hero visual: stacked image cards */
.hero-visual{
  position:relative;
  height:600px;
}
.hero-card{
  position:absolute;
  border-radius:var(--radius-lg);
  background:var(--surface);
  border:1px solid var(--border);
  overflow:hidden;
  box-shadow:var(--shadow-lg);
  transition: transform 1s var(--ease-out), box-shadow .5s var(--ease);
  will-change:transform;
}
.hero-card img{
  width:100%;height:100%;object-fit:contain;
  padding:30px;
  background:var(--surface-2);
}
.hero-card--main{
  width:78%;height:72%;top:8%;right:0;
  animation: float1 8s ease-in-out infinite;
}
.hero-card--sub-1{
  width:48%;height:44%;bottom:0;left:0;
  animation: float2 9s ease-in-out infinite;
  z-index:2;
}
.hero-card--sub-2{
  width:40%;height:34%;top:0;left:8%;
  animation: float3 7s ease-in-out infinite;
  z-index:2;
  background:var(--soft-grad);
  display:grid;place-items:center;
  text-align:center;padding:20px;
}
.hero-card--sub-2 .mini-label{
  font-family:'Fraunces',serif;
  font-size:1.05rem;
  color:var(--navy);
  letter-spacing:-.01em;
}
[data-theme="dark"] .hero-card--sub-2 .mini-label{color:var(--gold-2)}
.hero-card--sub-2 .mini-num{
  font-family:'Fraunces',serif;
  font-size:2.4rem;
  color:var(--gold);
  line-height:1;font-weight:500;
  font-variation-settings:"opsz" 144;
}

@keyframes float1{
  0%,100%{transform:translateY(0) rotate(-1deg)}
  50%{transform:translateY(-22px) rotate(-1deg)}
}
@keyframes float2{
  0%,100%{transform:translateY(0) rotate(2deg)}
  50%{transform:translateY(18px) rotate(2deg)}
}
@keyframes float3{
  0%,100%{transform:translateY(0) rotate(-3deg)}
  50%{transform:translateY(-14px) rotate(-3deg)}
}

/* Slide switching animation */
.hero-card img.fade-swap{opacity:0;transition:opacity .4s ease}
.hero-card img{opacity:1;transition:opacity .6s ease}

@media(max-width:1000px){
  .hero{padding:140px 0 80px;min-height:auto}
  .hero-deco{display:none}
  .hero-grid{grid-template-columns:1fr;gap:60px}
  .hero-visual{height:440px}
  .hero-card--main{width:82%;height:70%}
  .hero-card--sub-1{width:50%;height:42%}
  .hero-card--sub-2{width:42%;height:34%}
}
@media(max-width:600px){
  .hero-visual{height:340px}
  .hero-card img{padding:18px}
}

/* Scroll cue */
.scroll-cue{
  position:absolute;bottom:32px;left:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:10px;
  color:var(--text-muted);font-size:.68rem;
  letter-spacing:.3em;text-transform:uppercase;
  z-index:2;
}
.scroll-cue .line{
  width:1px;height:44px;background:var(--border-2);
  position:relative;overflow:hidden;
}
.scroll-cue .line::after{
  content:'';position:absolute;inset:0;background:var(--gold);
  animation: cue 2s ease-in-out infinite;
  transform-origin:top;
}
@keyframes cue{
  0%{transform:scaleY(0);transform-origin:top}
  50%{transform:scaleY(1);transform-origin:top}
  51%{transform-origin:bottom}
  100%{transform:scaleY(0);transform-origin:bottom}
}
@media(max-width:700px){.scroll-cue{display:none}}

/* ============================================================
   TICKER MARQUEE STRIP
============================================================ */
.ticker{
  background:var(--navy);
  color:#f4ecd8;
  padding:22px 0;
  overflow:hidden;
  border-top:1px solid rgba(255,255,255,.06);
  border-bottom:1px solid rgba(255,255,255,.06);
  position:relative;z-index:3;
}
[data-theme="dark"] .ticker{background:var(--surface-2);border-color:var(--border)}
.ticker-track{
  display:flex;gap:60px;align-items:center;
  width:max-content;
  animation: marquee 40s linear infinite;
  font-family:'Fraunces',serif;
  font-size:1.1rem;
  letter-spacing:-.01em;
  font-weight:400;
}
.ticker-item{display:flex;align-items:center;gap:60px;white-space:nowrap}
.ticker-item span{opacity:.92}
.ticker-item i{
  color:var(--gold-2);
  font-size:.7rem;
  opacity:.9;
}
@keyframes marquee{
  from{transform:translateX(0)}
  to{transform:translateX(-50%)}
}

/* ============================================================
   ABOUT
============================================================ */
.about-grid{
  display:grid;
  grid-template-columns:1fr 1.05fr;
  gap:100px;align-items:center;
}
.about-visual{
  position:relative;
  padding:40px 0;
}
.about-image{
  position:relative;
  aspect-ratio:1/1.15;
  border-radius:var(--radius-lg);
  overflow:hidden;
  background:var(--surface-2);
  border:1px solid var(--border);
  box-shadow:var(--shadow-md);
}
.about-image img{
  width:100%;height:100%;object-fit:cover;
  transition:transform 1.4s var(--ease-out);
}
.about-image:hover img{transform:scale(1.06)}

.about-frame{
  position:absolute;
  top:0;right:-20px;bottom:40px;left:40px;
  border:1px solid var(--gold);
  border-radius:var(--radius-lg);
  z-index:-1;opacity:.4;
}
.about-badge{
  position:absolute;bottom:0;left:-30px;
  background:var(--bg);
  border:1px solid var(--border);
  padding:26px 30px;
  border-radius:var(--radius-lg);
  box-shadow:var(--shadow-lg);
  z-index:2;
}
.about-badge .num{
  font-family:'Fraunces',serif;
  font-size:2.8rem;line-height:1;
  color:var(--gold);
  font-weight:500;
  margin-bottom:6px;
  font-variation-settings:"opsz" 144;
}
.about-badge .lbl{
  font-size:.72rem;letter-spacing:.2em;
  text-transform:uppercase;color:var(--text-muted);
  font-weight:600;
}

.about-content .section-title{margin-bottom:30px}
.about-content > p{
  color:var(--text-soft);
  font-size:1.05rem;
  line-height:1.8;
  margin-bottom:20px;
}
.about-content strong{color:var(--text);font-weight:600}

.about-list{
  list-style:none;padding:0;margin:36px 0 40px;
  display:grid;grid-template-columns:1fr 1fr;gap:14px 30px;
}
.about-list li{
  display:flex;align-items:flex-start;gap:12px;
  font-size:.95rem;color:var(--text-soft);
}
.about-list i{
  color:var(--gold);font-size:.75rem;margin-top:8px;
}

@media(max-width:1000px){
  .about-grid{grid-template-columns:1fr;gap:60px}
  .about-badge{left:0;bottom:-20px}
  .about-list{grid-template-columns:1fr}
}

/* ============================================================
   CAPABILITIES
============================================================ */
.caps-head{
  display:flex;justify-content:space-between;align-items:flex-end;
  gap:40px;flex-wrap:wrap;
  margin-bottom:70px;
  padding-bottom:36px;
  border-bottom:1px solid var(--border);
}
.caps-head .section-sub{margin:0}

.caps-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:0;
  border-top:1px solid var(--border);
  border-left:1px solid var(--border);
}
.cap{
  padding:48px 40px;
  border-right:1px solid var(--border);
  border-bottom:1px solid var(--border);
  position:relative;
  transition: background .5s var(--ease);
  overflow:hidden;
}
.cap::before{
  content:'';position:absolute;left:0;bottom:0;width:100%;height:2px;
