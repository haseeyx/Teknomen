<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Teknomen (Pvt) Ltd — Your Partner in Progress</title>
<meta name="description" content="TEKNOMEN delivers practical engineering solutions for Industrial Automation, VFDs, Customized Control Systems, Spindle Monitoring, Industrial Power Backup, PCB Design & Fabrication." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
/* ============================================================
   THEME TOKENS
============================================================ */
:root{
  --bg:#faf7f0; --bg-alt:#f3eee3; --surface:#ffffff; --surface-2:#f7f3ea;
  --text:#0a1a2f; --text-soft:#3d4a5c; --text-muted:#7a8394;
  --border:#e6ddc9; --border-2:#d9cfb8;
  --navy:#0d3b66; --navy-2:#14497a;
  --gold:#b8893a; --gold-2:#d4a55a; --copper:#b06a3b;
  --accent-grad: linear-gradient(90deg,#0d3b66 0%,#b8893a 100%);
  --soft-grad: linear-gradient(135deg,rgba(13,59,102,.06) 0%,rgba(184,137,58,.06) 100%);
  --shadow-sm: 0 1px 2px rgba(10,26,47,.04), 0 2px 8px rgba(10,26,47,.04);
  --shadow-md: 0 8px 30px rgba(10,26,47,.07);
  --shadow-lg: 0 30px 70px rgba(10,26,47,.14);
  --shadow-gold: 0 12px 40px rgba(184,137,58,.28);
  --radius:6px; --radius-lg:14px; --container:1240px;
  --ease: cubic-bezier(.22,.61,.36,1);
  --ease-out: cubic-bezier(.16,1,.3,1);
}
[data-theme="dark"]{
  --bg:#080f1a; --bg-alt:#0d1622; --surface:#111d2e; --surface-2:#16243a;
  --text:#ece6d6; --text-soft:#b6c1d0; --text-muted:#7c8a9e;
  --border:#1c2a3f; --border-2:#26374f;
  --navy:#5aa3dd; --navy-2:#7eb8e8;
  --gold:#dfb166; --gold-2:#efc98a; --copper:#d68b5a;
  --accent-grad: linear-gradient(90deg,#5aa3dd 0%,#dfb166 100%);
  --soft-grad: linear-gradient(135deg,rgba(90,163,221,.10) 0%,rgba(223,177,102,.08) 100%);
  --shadow-sm: 0 1px 2px rgba(0,0,0,.4), 0 2px 8px rgba(0,0,0,.35);
  --shadow-md: 0 10px 34px rgba(0,0,0,.5);
  --shadow-lg: 0 30px 70px rgba(0,0,0,.65);
  --shadow-gold: 0 12px 44px rgba(223,177,102,.22);
}

*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0; font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
  background:var(--bg); color:var(--text); line-height:1.7;
  -webkit-font-smoothing:antialiased;
  transition: background .5s var(--ease), color .5s var(--ease);
  overflow-x:hidden;
}
body::before{
  content:''; position:fixed; inset:0; z-index:1; pointer-events:none; opacity:.035;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  mix-blend-mode:multiply;
}
[data-theme="dark"] body::before{mix-blend-mode:screen;opacity:.05}

h1,h2,h3,h4,h5{font-family:'Fraunces',serif;font-weight:500;line-height:1.12;letter-spacing:-.02em;margin:0;color:var(--text);font-variation-settings:"opsz" 144}
h1{font-weight:400}
p{margin:0 0 1em}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block;height:auto}
button{font-family:inherit;cursor:pointer;border:0;background:none;color:inherit}
::selection{background:var(--gold);color:#fff}

.container{max-width:var(--container);margin:0 auto;padding:0 28px;position:relative;z-index:2}
.section{padding:130px 0;position:relative}
.section-alt{background:var(--bg-alt)}

.eyebrow{display:inline-flex;align-items:center;gap:12px;font-family:'Inter',sans-serif;text-transform:uppercase;font-size:.72rem;letter-spacing:.28em;color:var(--gold);font-weight:600;margin-bottom:22px}
.eyebrow::before{content:'';width:32px;height:1px;background:var(--gold);display:block}
.section-title{font-size:clamp(2.2rem,4.6vw,3.8rem);margin-bottom:22px;letter-spacing:-.03em}
.section-title em{font-style:italic;color:var(--gold);font-weight:400}
.section-sub{color:var(--text-soft);max-width:620px;font-size:1.02rem;line-height:1.75}
.sec-num{font-family:'Fraunces',serif;font-size:.9rem;color:var(--text-muted);letter-spacing:.3em;font-weight:500;font-variation-settings:"opsz" 144}
.text-center{text-align:center}

/* Buttons */
.btn{display:inline-flex;align-items:center;gap:12px;padding:15px 30px;border-radius:2px;font-family:'Inter',sans-serif;font-weight:500;letter-spacing:.02em;font-size:.9rem;transition:all .4s var(--ease);position:relative;overflow:hidden;border:1px solid transparent}
.btn-primary{background:var(--navy);color:#fff}
[data-theme="dark"] .btn-primary{color:#080f1a}
.btn-primary::before{content:'';position:absolute;inset:0;background:var(--gold);transform:translateY(101%);transition:transform .5s var(--ease-out)}
.btn-primary:hover::before{transform:translateY(0)}
.btn-primary > *{position:relative;z-index:1}
.btn-primary:hover{color:#fff}
[data-theme="dark"] .btn-primary:hover{color:#080f1a}
.btn-ghost{border-color:var(--border-2);color:var(--text)}
.btn-ghost:hover{border-color:var(--gold);color:var(--gold);padding-left:38px}
.btn i{transition:transform .4s var(--ease)}
.btn:hover i{transform:translateX(5px)}

.hairline{display:inline-flex;align-items:center;gap:8px;position:relative;font-weight:500;font-size:.9rem;color:var(--text);padding-bottom:2px}
.hairline::after{content:'';position:absolute;left:0;bottom:0;right:0;height:1px;background:var(--gold);transform:scaleX(0);transform-origin:right;transition:transform .5s var(--ease-out)}
.hairline:hover::after{transform:scaleX(1);transform-origin:left}

/* ============================================================
   SCROLL PROGRESS
============================================================ */
.scroll-progress{position:fixed;top:0;left:0;right:0;height:2px;z-index:2000;pointer-events:none}
.scroll-progress__bar{height:100%;width:0%;background:var(--accent-grad);box-shadow:0 0 12px rgba(184,137,58,.5);transition:width .08s linear}

/* ============================================================
   HEADER
============================================================ */
.header{position:fixed;top:2px;left:0;right:0;z-index:1000;background:color-mix(in srgb, var(--bg) 78%, transparent);backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);border-bottom:1px solid transparent;transition:all .4s var(--ease)}
.header.scrolled{border-bottom-color:var(--border)}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:86px;transition:height .4s var(--ease)}
.header.scrolled .header-inner{height:74px}
.logo{display:flex;align-items:center;gap:14px}
.logo img{height:38px;width:auto;transition:height .4s var(--ease),filter .4s var(--ease);filter:brightness(0) saturate(100%) invert(15%) sepia(38%) saturate(2476%) hue-rotate(193deg) brightness(95%) contrast(95%)}
[data-theme="dark"] .logo img{filter:brightness(0) saturate(100%) invert(92%) sepia(8%) saturate(600%) hue-rotate(346deg) brightness(98%) contrast(92%)}
.header.scrolled .logo img{height:32px}
.nav{display:flex;align-items:center;gap:2px}
.nav a{padding:10px 16px;font-size:.9rem;font-weight:500;color:var(--text-soft);position:relative;transition:color .3s var(--ease)}
.nav a::after{content:'';position:absolute;left:16px;right:16px;bottom:4px;height:1px;background:var(--gold);transform:scaleX(0);transform-origin:right;transition:transform .45s var(--ease-out)}
.nav a:hover,.nav a.active{color:var(--text)}
.nav a:hover::after,.nav a.active::after{transform:scaleX(1);transform-origin:left}
.header-actions{display:flex;align-items:center;gap:14px}
.theme-toggle{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--border-2);color:var(--text-soft);transition:all .4s var(--ease);position:relative;overflow:hidden}
.theme-toggle::before{content:'';position:absolute;inset:0;border-radius:50%;background:var(--gold);transform:scale(0);transition:transform .4s var(--ease-out)}
.theme-toggle:hover::before{transform:scale(1)}
.theme-toggle:hover{color:#fff;border-color:var(--gold)}
.theme-toggle i{position:absolute;z-index:1;font-size:.9rem;transition:all .55s var(--ease-out)}
.theme-toggle .fa-sun{opacity:0;transform:scale(.4) rotate(90deg)}
.theme-toggle .fa-moon{opacity:1;transform:scale(1) rotate(0)}
[data-theme="dark"] .theme-toggle .fa-sun{opacity:1;transform:scale(1) rotate(0)}
[data-theme="dark"] .theme-toggle .fa-moon{opacity:0;transform:scale(.4) rotate(-90deg)}
.header-cta{padding:11px 22px;background:var(--navy);color:#fff;font-size:.82rem;font-weight:500;letter-spacing:.04em;border-radius:2px;position:relative;overflow:hidden;transition:all .35s var(--ease)}
[data-theme="dark"] .header-cta{color:#080f1a}
.header-cta::before{content:'';position:absolute;inset:0;background:var(--gold);transform:translateY(101%);transition:transform .4s var(--ease-out)}
.header-cta:hover::before{transform:translateY(0)}
.header-cta span{position:relative;z-index:1}
.header-cta:hover{color:#fff}
[data-theme="dark"] .header-cta:hover{color:#080f1a}
.menu-toggle{display:none;width:42px;height:42px;color:var(--text);font-size:1.05rem}
@media(max-width:1000px){
  .nav{position:fixed;top:88px;left:0;right:0;background:var(--bg);flex-direction:column;align-items:stretch;padding:16px;gap:2px;border-top:1px solid var(--border);border-bottom:1px solid var(--border);transform:translateY(-120%);transition:transform .45s var(--ease);max-height:calc(100vh - 88px);overflow-y:auto}
  .nav.open{transform:translateY(0)}
  .nav a{padding:16px 18px}
  .menu-toggle{display:grid;place-items:center}
  .header-cta{display:none}
}

/* ============================================================
   HERO
============================================================ */
.hero{position:relative;min-height:100vh;padding:180px 0 100px;display:flex;align-items:center;overflow:hidden;isolation:isolate;background:var(--bg)}
.hero::before{content:'';position:absolute;inset:0;z-index:-1;background:radial-gradient(circle at 15% 20%,color-mix(in srgb,var(--gold) 8%,transparent),transparent 45%),radial-gradient(circle at 85% 75%,color-mix(in srgb,var(--navy) 6%,transparent),transparent 50%)}
.hero-deco{position:absolute;top:180px;bottom:80px;left:28px;width:1px;background:linear-gradient(to bottom,transparent,var(--border-2),transparent);z-index:1}
.hero-deco span{position:absolute;top:0;left:50%;transform:translateX(-50%);background:var(--bg);padding:6px 0;font-family:'Fraunces',serif;font-size:.75rem;letter-spacing:.3em;color:var(--text-muted)}
.hero-grid{display:grid;grid-template-columns:1.15fr .95fr;gap:80px;align-items:center;position:relative;z-index:2}
.hero-content{max-width:640px}
.hero-content h1{font-size:clamp(2.6rem,5.6vw,4.6rem);line-height:1.02;margin-bottom:30px;letter-spacing:-.035em;font-weight:400}
.hero-content h1 em{font-style:italic;color:var(--gold);font-weight:300}
.hero-content p{color:var(--text-soft);font-size:1.08rem;line-height:1.75;max-width:540px;margin-bottom:40px}
.hero-cta{display:flex;gap:16px;flex-wrap:wrap;align-items:center}
.hero-visual{position:relative;height:600px}
.hero-card{position:absolute;border-radius:var(--radius-lg);background:var(--surface);border:1px solid var(--border);overflow:hidden;box-shadow:var(--shadow-lg);will-change:transform}
.hero-card img{width:100%;height:100%;object-fit:contain;padding:30px;background:var(--surface-2);opacity:1;transition:opacity .6s ease}
.hero-card img.fade-swap{opacity:0;transition:opacity .4s ease}
.hero-card--main{width:78%;height:72%;top:8%;right:0;animation:float1 8s ease-in-out infinite}
.hero-card--sub-1{width:48%;height:44%;bottom:0;left:0;animation:float2 9s ease-in-out infinite;z-index:2}
.hero-card--sub-2{width:40%;height:34%;top:0;left:8%;animation:float3 7s ease-in-out infinite;z-index:2;background:var(--soft-grad);display:grid;place-items:center;text-align:center;padding:20px}
.hero-card--sub-2 .mini-label{font-family:'Fraunces',serif;font-size:1.05rem;color:var(--navy)}
[data-theme="dark"] .hero-card--sub-2 .mini-label{color:var(--gold-2)}
.hero-card--sub-2 .mini-num{font-family:'Fraunces',serif;font-size:2.4rem;color:var(--gold);line-height:1;font-weight:500;font-variation-settings:"opsz" 144}
@keyframes float1{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-22px) rotate(-1deg)}}
@keyframes float2{0%,100%{transform:translateY(0) rotate(2deg)}50%{transform:translateY(18px) rotate(2deg)}}
@keyframes float3{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-14px) rotate(-3deg)}}
@media(max-width:1000px){
  .hero{padding:140px 0 80px;min-height:auto}
  .hero-deco{display:none}
  .hero-grid{grid-template-columns:1fr;gap:60px}
  .hero-visual{height:440px}
  .hero-card--main{width:82%;height:70%}
  .hero-card--sub-1{width:50%;height:42%}
  .hero-card--sub-2{width:42%;height:34%}
}
@media(max-width:600px){.hero-visual{height:340px}.hero-card img{padding:18px}}

.scroll-cue{position:absolute;bottom:32px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:10px;color:var(--text-muted);font-size:.68rem;letter-spacing:.3em;text-transform:uppercase;z-index:2}
.scroll-cue .line{width:1px;height:44px;background:var(--border-2);position:relative;overflow:hidden}
.scroll-cue .line::after{content:'';position:absolute;inset:0;background:var(--gold);animation:cue 2s ease-in-out infinite;transform-origin:top}
@keyframes cue{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
@media(max-width:700px){.scroll-cue{display:none}}

/* ============================================================
   TICKER
============================================================ */
.ticker{background:var(--navy);color:#f4ecd8;padding:22px 0;overflow:hidden;border-top:1px solid rgba(255,255,255,.06);border-bottom:1px solid rgba(255,255,255,.06);position:relative;z-index:3}
[data-theme="dark"] .ticker{background:var(--surface-2);border-color:var(--border);color:var(--text)}
.ticker-track{display:flex;gap:60px;align-items:center;width:max-content;animation:marquee 40s linear infinite;font-family:'Fraunces',serif;font-size:1.1rem;font-weight:400}
.ticker-item{display:flex;align-items:center;gap:60px;white-space:nowrap}
.ticker-item span{opacity:.92}
.ticker-item i{color:var(--gold-2);font-size:.7rem}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ============================================================
   ABOUT
============================================================ */
.about-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:100px;align-items:center}
.about-visual{position:relative;padding:40px 0}
.about-image{position:relative;aspect-ratio:1/1.15;border-radius:var(--radius-lg);overflow:hidden;background:var(--surface-2);border:1px solid var(--border);box-shadow:var(--shadow-md)}
.about-image img{width:100%;height:100%;object-fit:cover;transition:transform 1.4s var(--ease-out)}
.about-image:hover img{transform:scale(1.06)}
.about-frame{position:absolute;top:0;right:-20px;bottom:40px;left:40px;border:1px solid var(--gold);border-radius:var(--radius-lg);z-index:-1;opacity:.4}
.about-badge{position:absolute;bottom:0;left:-30px;background:var(--bg);border:1px solid var(--border);padding:26px 30px;border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);z-index:2}
.about-badge .num{font-family:'Fraunces',serif;font-size:2.8rem;line-height:1;color:var(--gold);font-weight:500;margin-bottom:6px;font-variation-settings:"opsz" 144}
.about-badge .lbl{font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--text-muted);font-weight:600}
.about-content .section-title{margin-bottom:30px}
.about-content > p{color:var(--text-soft);font-size:1.05rem;line-height:1.8;margin-bottom:20px}
.about-content strong{color:var(--text);font-weight:600}
.about-list{list-style:none;padding:0;margin:36px 0 40px;display:grid;grid-template-columns:1fr 1fr;gap:14px 30px}
.about-list li{display:flex;align-items:flex-start;gap:12px;font-size:.95rem;color:var(--text-soft)}
.about-list i{color:var(--gold);font-size:.75rem;margin-top:8px}
@media(max-width:1000px){.about-grid{grid-template-columns:1fr;gap:60px}.about-badge{left:0;bottom:-20px}.about-list{grid-template-columns:1fr}}

/* ============================================================
   CAPABILITIES
============================================================ */
.caps-head{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;flex-wrap:wrap;margin-bottom:70px;padding-bottom:36px;border-bottom:1px solid var(--border)}
.caps-head .section-sub{margin:0}
.caps-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--border);border-left:1px solid var(--border)}
.cap{padding:52px 42px;border-right:1px solid var(--border);border-bottom:1px solid var(--border);position:relative;transition:background .5s var(--ease);overflow:hidden;cursor:pointer}
.cap::before{content:'';position:absolute;left:0;bottom:0;width:100%;height:2px;background:var(--accent-grad);transform:scaleX(0);transform-origin:left;transition:transform .6s var(--ease-out)}
.cap::after{content:'';position:absolute;inset:0;background:var(--soft-grad);opacity:0;transition:opacity .5s var(--ease);pointer-events:none}
.cap:hover{background:var(--surface)}
.cap:hover::before{transform:scaleX(1)}
.cap:hover::after{opacity:1}
.cap-num{font-family:'Fraunces',serif;font-size:.78rem;letter-spacing:.28em;color:var(--text-muted);margin-bottom:30px;font-weight:500}
.cap-icon{width:64px;height:64px;display:grid;place-items:center;color:var(--gold);font-size:1.7rem;margin-bottom:26px;border:1px solid var(--border-2);border-radius:50%;position:relative;transition:all .6s var(--ease-out)}
.cap-icon::before{content:'';position:absolute;inset:-1px;border-radius:50%;background:var(--accent-grad);opacity:0;transition:opacity .5s var(--ease);z-index:-1}
.cap:hover .cap-icon{color:#fff;border-color:transparent;transform:rotate(-8deg) scale(1.05)}
.cap:hover .cap-icon::before{opacity:1}
[data-theme="dark"] .cap:hover .cap-icon{color:#080f1a}
.cap h3{font-size:1.35rem;margin-bottom:12px;font-weight:500;letter-spacing:-.015em;position:relative;z-index:1}
.cap p{color:var(--text-muted);font-size:.92rem;line-height:1.7;margin:0;position:relative;z-index:1}
@media(max-width:1000px){.caps-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.caps-grid{grid-template-columns:1fr}.cap{padding:38px 30px}}

/* ============================================================
   WHY CHOOSE US
============================================================ */
.why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:60px}
.why-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:36px 30px;position:relative;overflow:hidden;transition:all .55s var(--ease)}
.why-card::before{content:'';position:absolute;top:0;left:0;width:100%;height:3px;background:var(--accent-grad);transform:scaleX(0);transform-origin:right;transition:transform .6s var(--ease-out)}
.why-card:hover{transform:translateY(-10px);box-shadow:var(--shadow-lg);border-color:var(--gold)}
.why-card:hover::before{transform:scaleX(1);transform-origin:left}
.why-num{font-family:'Fraunces',serif;font-size:3rem;line-height:1;color:var(--gold);opacity:.22;font-weight:400;font-variation-settings:"opsz" 144;position:absolute;top:20px;right:24px;transition:opacity .5s var(--ease)}
.why-card:hover .why-num{opacity:.5}
.why-icon{width:56px;height:56px;display:grid;place-items:center;border-radius:14px;background:var(--soft-grad);color:var(--gold);font-size:1.4rem;margin-bottom:24px;transition:all .5s var(--ease-out)}
.why-card:hover .why-icon{transform:rotate(-6deg) scale(1.1);background:var(--gold);color:#fff}
.why-card h3{font-size:1.2rem;margin-bottom:12px;font-weight:500}
.why-card p{color:var(--text-muted);font-size:.9rem;line-height:1.7;margin:0}
@media(max-width:1000px){.why-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.why-grid{grid-template-columns:1fr}}

/* ============================================================
   PROCESS TIMELINE
============================================================ */
.process-wrap{position:relative;margin-top:70px;padding-left:0}
.process-line{position:absolute;left:50%;top:0;bottom:0;width:2px;background:var(--border);transform:translateX(-50%)}
.process-line-fill{position:absolute;left:50%;top:0;width:2px;background:var(--accent-grad);transform:translateX(-50%);height:0;transition:height 1s var(--ease-out)}
.process-step{display:grid;grid-template-columns:1fr 80px 1fr;gap:0;align-items:center;margin-bottom:80px;position:relative}
.process-step:last-child{margin-bottom:0}
.process-step .step-content{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:36px 34px;transition:all .55s var(--ease);position:relative}
.process-step .step-content:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg);border-color:var(--gold)}
.process-step:nth-child(odd) .step-content{grid-column:1;text-align:right}
.process-step:nth-child(even) .step-content{grid-column:3;text-align:left}
.process-step .step-num{display:grid;place-items:center;grid-column:2;z-index:2}
.process-step .step-num span{width:56px;height:56px;border-radius:50%;background:var(--bg);border:2px solid var(--gold);color:var(--gold);display:grid;place-items:center;font-family:'Fraunces',serif;font-size:1.1rem;font-weight:500;font-variation-settings:"opsz" 144;box-shadow:var(--shadow-md);transition:all .5s var(--ease)}
.process-step:hover .step-num span{background:var(--gold);color:#fff;transform:scale(1.1)}
.process-step .step-content h3{font-size:1.25rem;margin-bottom:10px;font-weight:500}
.process-step .step-content p{color:var(--text-muted);font-size:.92rem;line-height:1.7;margin:0}
.process-step:nth-child(even) .step-content{grid-row:1}
.process-step:nth-child(even) .step-num{grid-row:1}
@media(max-width:800px){
  .process-line,.process-line-fill{left:28px}
  .process-step{grid-template-columns:56px 1fr;gap:20px;margin-bottom:40px}
  .process-step .step-content,.process-step:nth-child(odd) .step-content,.process-step:nth-child(even) .step-content{grid-column:2;grid-row:1;text-align:left}
  .process-step .step-num,.process-step:nth-child(even) .step-num{grid-column:1;grid-row:1}
}

/* ============================================================
   STATS
============================================================ */
.stats{padding:100px 0;background:var(--navy);color:#f4ecd8;position:relative;overflow:hidden}
[data-theme="dark"] .stats{background:var(--surface-2);color:var(--text)}
.stats::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 12% 30%,rgba(212,165,90,.14),transparent 40%),radial-gradient(circle at 88% 70%,rgba(212,165,90,.10),transparent 40%)}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative;z-index:2}
.stat{padding:0 32px;border-left:1px solid rgba(255,255,255,.14)}
[data-theme="dark"] .stat{border-color:var(--border)}
.stat:first-child{border-left:0}
.stat-num{font-family:'Fraunces',serif;font-size:clamp(2.4rem,4.4vw,3.6rem);font-weight:400;line-height:1;margin-bottom:16px;color:#f4ecd8;font-variation-settings:"opsz" 144;letter-spacing:-.03em}
[data-theme="dark"] .stat-num{color:var(--text)}
.stat-num em{color:var(--gold-2);font-style:italic;font-weight:300}
.stat-label{font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;font-weight:600;opacity:.75}
@media(max-width:900px){.stats-grid{grid-template-columns:repeat(2,1fr);gap:40px 0}.stat{border-left:0;padding:0 20px}.stat:nth-child(odd){padding-left:0}}
@media(max-width:520px){.stats-grid{grid-template-columns:1fr;gap:36px 0;text-align:center}.stat{padding:0}}

/* ============================================================
   SOLUTIONS
============================================================ */
.solutions-head{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;flex-wrap:wrap;margin-bottom:60px}
.solutions-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}
.sol{display:block;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;transition:all .55s var(--ease);position:relative}
.sol::after{content:'\f061';font-family:'Font Awesome 6 Free';font-weight:900;position:absolute;top:24px;right:24px;width:44px;height:44px;border-radius:50%;background:var(--bg);border:1px solid var(--border);display:grid;place-items:center;font-size:.75rem;color:var(--text);opacity:0;transform:scale(.7) rotate(-45deg);transition:all .5s var(--ease-out);z-index:2}
.sol:hover::after{opacity:1;transform:scale(1) rotate(0)}
.sol:hover{transform:translateY(-8px);border-color:var(--gold);box-shadow:var(--shadow-lg)}
.sol-img{aspect-ratio:5/4;background:var(--surface-2);display:grid;place-items:center;padding:36px;overflow:hidden;position:relative}
.sol-img img{max-width:100%;max-height:100%;object-fit:contain;transition:transform .9s var(--ease-out)}
.sol:hover .sol-img img{transform:scale(1.1)}
.sol-body{padding:26px 28px 30px;border-top:1px solid var(--border)}
.sol-cat{font-size:.7rem;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:10px}
.sol-body h3{font-size:1.35rem;font-weight:500;letter-spacing:-.015em;margin:0}
@media(max-width:1000px){.solutions-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.solutions-grid{grid-template-columns:1fr;gap:20px}}

/* ============================================================
   INDUSTRIES
============================================================ */
.industries-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:60px}
.ind{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:40px 30px;text-align:center;position:relative;overflow:hidden;transition:all .55s var(--ease);cursor:pointer}
.ind::before{content:'';position:absolute;top:0;left:0;width:100%;height:100%;background:var(--soft-grad);opacity:0;transition:opacity .5s var(--ease)}
.ind:hover{transform:translateY(-8px);border-color:var(--gold);box-shadow:var(--shadow-lg)}
.ind:hover::before{opacity:1}
.ind-icon{width:70px;height:70px;margin:0 auto 22px;display:grid;place-items:center;border-radius:50%;background:var(--soft-grad);color:var(--gold);font-size:1.6rem;transition:all .6s var(--ease-out);position:relative;z-index:1}
.ind:hover .ind-icon{transform:rotate(-10deg) scale(1.1);background:var(--gold);color:#fff;box-shadow:var(--shadow-gold)}
.ind h3{font-size:1.15rem;margin-bottom:10px;font-weight:500;position:relative;z-index:1}
.ind p{color:var(--text-muted);font-size:.88rem;margin:0;position:relative;z-index:1}
@media(max-width:900px){.industries-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.industries-grid{grid-template-columns:1fr}}

/* ============================================================
   TESTIMONIALS
============================================================ */
.testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin-top:60px}
.testi{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:40px 34px;position:relative;transition:all .55s var(--ease)}
.testi:hover{transform:translateY(-8px);box-shadow:var(--shadow-lg);border-color:var(--gold)}
.testi-quote{font-family:'Fraunces',serif;font-size:3rem;line-height:1;color:var(--gold);opacity:.25;position:absolute;top:24px;right:28px;font-style:italic;font-weight:400}
.testi-stars{color:var(--gold);font-size:.85rem;letter-spacing:2px;margin-bottom:20px}
.testi-text{font-family:'Fraunces',serif;font-size:1.05rem;line-height:1.65;color:var(--text-soft);margin-bottom:28px;font-style:italic;font-weight:400}
.testi-author{display:flex;align-items:center;gap:14px;padding-top:22px;border-top:1px solid var(--border)}
.testi-avatar{width:48px;height:48px;border-radius:50%;background:var(--accent-grad);color:#fff;display:grid;place-items:center;font-family:'Fraunces',serif;font-size:1.15rem;font-weight:500;font-variation-settings:"opsz" 144}
.testi-name{font-weight:600;font-size:.95rem;color:var(--text)}
.testi-role{font-size:.82rem;color:var(--text-muted)}
@media(max-width:1000px){.testi-grid{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.testi-grid{grid-template-columns:1fr}}

/* ============================================================
   CLIENTS  —  redesigned
============================================================ */
.clients-section{position:relative;overflow:hidden}
.clients-meta{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;flex-wrap:wrap;margin-bottom:50px;padding-bottom:36px;border-bottom:1px solid var(--border)}
.clients-badge{display:inline-flex;align-items:center;gap:14px;padding:12px 22px;border:1px solid var(--border-2);border-radius:100px;font-size:.82rem;color:var(--text-soft);background:var(--surface)}
.clients-badge .dot{width:8px;height:8px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 4px color-mix(in srgb,var(--gold) 20%,transparent);animation:ping 2s infinite}
@keyframes ping{0%,100%{box-shadow:0 0 0 0 color-mix(in srgb,var(--gold) 40%,transparent)}50%{box-shadow:0 0 0 8px transparent}}
.clients-badge strong{color:var(--text);font-weight:600}

/* Featured marquee strip */
.clients-strip{position:relative;padding:26px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);overflow:hidden;margin-bottom:70px;background:var(--surface)}
.clients-strip::before,.clients-strip::after{content:'';position:absolute;top:0;bottom:0;width:160px;z-index:2;pointer-events:none}
.clients-strip::before{left:0;background:linear-gradient(to right,var(--surface),transparent)}
.clients-strip::after{right:0;background:linear-gradient(to left,var(--surface),transparent)}
.clients-strip-track{display:flex;gap:80px;align-items:center;animation:marquee 55s linear infinite;width:max-content}
.clients-strip-track:hover{animation-play-state:paused}
.clients-strip .client-logo{height:44px;display:grid;place-items:center;flex-shrink:0;filter:grayscale(1) opacity(.55);transition:all .4s var(--ease)}
.clients-strip .client-logo img{max-height:44px;width:auto;max-width:120px;object-fit:contain}
.clients-strip .client-logo:hover{filter:grayscale(0) opacity(1)}
[data-theme="dark"] .clients-strip .client-logo{filter:grayscale(1) opacity(.5) invert(.85)}
[data-theme="dark"] .clients-strip .client-logo:hover{filter:invert(0) grayscale(0)}

/* Client grid */
.clients-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.client-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:36px 22px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;min-height:170px;position:relative;overflow:hidden;transition:all .55s var(--ease);cursor:pointer}
.client-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--accent-grad);transform:scaleX(0);transform-origin:center;transition:transform .6s var(--ease-out)}
.client-card::after{content:'';position:absolute;inset:0;background:var(--soft-grad);opacity:0;transition:opacity .5s var(--ease);pointer-events:none}
.client-card:hover{transform:translateY(-8px);border-color:var(--gold);box-shadow:var(--shadow-lg)}
.client-card:hover::before{transform:scaleX(1)}
.client-card:hover::after{opacity:1}
.client-card .logo-box{height:70px;display:grid;place-items:center;position:relative;z-index:1}
.client-card .logo-box img{max-height:70px;max-width:130px;width:auto;object-fit:contain;filter:grayscale(1) opacity(.7);transition:all .5s var(--ease)}
.client-card:hover .logo-box img{filter:grayscale(0) opacity(1);transform:scale(1.06)}
[data-theme="dark"] .client-card .logo-box img{filter:grayscale(1) opacity(.55) invert(.85)}
[data-theme="dark"] .client-card:hover .logo-box img{filter:invert(0) grayscale(0) opacity(1)}
.client-card .client-tag{font-size:.68rem;letter-spacing:.22em;text-transform:uppercase;color:var(--text-muted);font-weight:600;position:relative;z-index:1;transition:color .35s var(--ease)}
.client-card:hover .client-tag{color:var(--gold)}

.clients-cta{text-align:center;margin-top:60px}
.clients-cta .btn{font-size:.88rem}

@media(max-width:1000px){.clients-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:720px){.clients-grid{grid-template-columns:repeat(2,1fr);gap:14px}.client-card{padding:26px 16px;min-height:140px}.client-card .logo-box{height:56px}.client-card .logo-box img{max-height:56px;max-width:100px}}

/* ============================================================
   FAQ
============================================================ */
.faq-wrap{max-width:860px;margin:60px auto 0}
.faq-item{border-bottom:1px solid var(--border);padding:0;overflow:hidden}
.faq-item:first-child{border-top:1px solid var(--border)}
.faq-q{width:100%;text-align:left;padding:28px 40px 28px 0;font-family:'Fraunces',serif;font-size:1.15rem;font-weight:500;color:var(--text);position:relative;transition:color .3s var(--ease);display:flex;align-items:center;justify-content:space-between;gap:20px;letter-spacing:-.01em}
.faq-q:hover{color:var(--gold)}
.faq-q .plus{width:26px;height:26px;border-radius:50%;border:1px solid var(--border-2);display:grid;place-items:center;font-size:.75rem;color:var(--text-soft);transition:all .45s var(--ease);flex-shrink:0}
.faq-item.open .faq-q{color:var(--gold)}
.faq-item.open .plus{background:var(--gold);color:#fff;border-color:var(--gold);transform:rotate(45deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .55s var(--ease-out),padding .4s var(--ease)}
.faq-item.open .faq-a{max-height:340px;padding-bottom:28px}
.faq-a p{color:var(--text-muted);font-size:.95rem;line-height:1.8;margin:0;padding-right:40px}

/* ============================================================
   CTA BAND
============================================================ */
.cta-band{padding:140px 0;text-align:center;position:relative;overflow:hidden;background:var(--bg-alt)}
.cta-band::before{content:'';position:absolute;top:50%;left:50%;width:900px;height:900px;transform:translate(-50%,-50%);background:radial-gradient(circle,color-mix(in srgb,var(--gold) 12%,transparent),transparent 65%);pointer-events:none}
.cta-band h2{font-size:clamp(2rem,4.4vw,3.4rem);margin-bottom:26px;max-width:820px;margin-left:auto;margin-right:auto}
.cta-band h2 em{color:var(--gold);font-style:italic;font-weight:300}
.cta-band p{color:var(--text-soft);max-width:560px;margin:0 auto 40px;font-size:1.02rem}
.cta-band .btn{font-size:.95rem;padding:17px 36px}

/* ============================================================
   FOOTER
============================================================ */
.footer{background:var(--navy);color:#e8ddc5;padding:100px 0 0;position:relative;overflow:hidden}
[data-theme="dark"] .footer{background:var(--surface-2);color:var(--text)}
.footer::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:var(--accent-grad)}
.footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.3fr;gap:60px;padding-bottom:70px;border-bottom:1px solid rgba(255,255,255,.12);position:relative;z-index:2}
[data-theme="dark"] .footer-grid{border-color:var(--border)}
.footer .logo img{filter:brightness(0) invert(1);height:36px}
[data-theme="dark"] .footer .logo img{filter:brightness(0) saturate(100%) invert(92%) sepia(8%) saturate(600%) hue-rotate(346deg) brightness(98%) contrast(92%)}
.footer-about p{margin-top:22px;color:rgba(232,221,197,.7);font-size:.94rem;line-height:1.75;max-width:340px}
[data-theme="dark"] .footer-about p{color:var(--text-muted)}
.footer h4{font-family:'Inter',sans-serif;font-size:.72rem;text-transform:uppercase;letter-spacing:.24em;margin-bottom:26px;color:var(--gold-2);font-weight:600}
.footer-links{display:flex;flex-direction:column;gap:14px}
.footer-links a{color:rgba(232,221,197,.75);font-size:.94rem;transition:all .35s var(--ease);display:inline-flex;align-items:center;gap:10px;width:fit-content;position:relative;padding-left:0}
.footer-links a::before{content:'';width:0;height:1px;background:var(--gold-2);transition:width .4s var(--ease-out)}
.footer-links a:hover{color:#fff;padding-left:4px}
.footer-links a:hover::before{width:16px}
[data-theme="dark"] .footer-links a{color:var(--text-muted)}
[data-theme="dark"] .footer-links a:hover{color:var(--text)}
.footer-links a i{color:var(--gold-2);font-size:.85rem;width:16px}
.footer-bottom{padding:32px 0;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;color:rgba(232,221,197,.55);font-size:.82rem;letter-spacing:.02em;position:relative;z-index:2}
[data-theme="dark"] .footer-bottom{color:var(--text-muted)}
.footer-social{display:flex;gap:10px}
.footer-social a{width:40px;height:40px;border-radius:50%;border:1px solid rgba(255,255,255,.2);display:grid;place-items:center;color:rgba(232,221,197,.75);transition:all .4s var(--ease);font-size:.85rem}
.footer-social a:hover{background:var(--gold);color:#0a1a2f;border-color:var(--gold);transform:translateY(-4px);box-shadow:var(--shadow-gold)}
[data-theme="dark"] .footer-social a{border-color:var(--border);color:var(--text-muted)}
@media(max-width:900px){.footer-grid{grid-template-columns:1fr 1fr;gap:40px}}
@media(max-width:560px){.footer-grid{grid-template-columns:1fr}.footer-bottom{justify-content:center;text-align:center}}

/* ============================================================
   FLOATING
============================================================ */
.whatsapp{position:fixed;right:22px;bottom:22px;z-index:990;width:54px;height:54px;border-radius:50%;background:#25d366;color:#fff;display:grid;place-items:center;font-size:1.5rem;box-shadow:0 12px 30px rgba(37,211,102,.4);transition:transform .35s var(--ease)}
.whatsapp::after{content:'';position:absolute;inset:0;border-radius:50%;border:2px solid #25d366;animation:pulse 2.4s infinite}
.whatsapp:hover{transform:scale(1.1) rotate(-6deg)}
@keyframes pulse{0%{transform:scale(1);opacity:.7}100%{transform:scale(1.5);opacity:0}}
.to-top{position:fixed;right:22px;bottom:90px;z-index:990;width:44px;height:44px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;font-size:.9rem;box-shadow:var(--shadow-md);opacity:0;pointer-events:none;transform:translateY(12px);transition:all .4s var(--ease)}
[data-theme="dark"] .to-top{color:#080f1a}
.to-top.show{opacity:1;pointer-events:auto;transform:translateY(0)}
.to-top:hover{background:var(--gold);color:#fff;transform:translateY(-4px)}
[data-theme="dark"] .to-top:hover{color:#080f1a}

/* ============================================================
   REVEAL & ANIMATIONS
============================================================ */
.reveal{opacity:0;transform:translateY(36px);transition:opacity 1s var(--ease-out),transform 1s var(--ease-out);will-change:opacity,transform}
.reveal.in{opacity:1;transform:none}
.reveal[data-delay="1"]{transition-delay:.1s}
.reveal[data-delay="2"]{transition-delay:.2s}
.reveal[data-delay="3"]{transition-delay:.3s}
.reveal[data-delay="4"]{transition-delay:.4s}
.reveal[data-delay="5"]{transition-delay:.5s}
.reveal[data-delay="6"]{transition-delay:.6s}

/* Mask-line heading reveal */
.mask-line{display:block;overflow:hidden}
.mask-line > span{display:block;transform:translateY(105%);transition:transform 1.1s var(--ease-out)}
.reveal.in .mask-line > span, .mask-line.in > span{transform:translateY(0)}

/* Subtle tilt */
.tilt{transform-style:preserve-3d;transition:transform .4s var(--ease-out)}
.tilt-inner{transition:transform .4s var(--ease-out)}

@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.001s !important;animation-iteration-count:1 !important;transition-duration:.001s !important;scroll-behavior:auto !important}
  .reveal,.mask-line > span{opacity:1;transform:none}
}
</style>
</head>
